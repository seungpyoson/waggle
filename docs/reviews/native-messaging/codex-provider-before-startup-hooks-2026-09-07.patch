+#[tokio::test]
+async fn thread_subscribe_survives_original_client_disconnect_and_observes_archive() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let codex_home = TempDir::new()?;
+    create_config_toml(codex_home.path(), &server.uri(), "never")?;
+    let (mut process, bind_addr) = spawn_websocket_server(codex_home.path()).await?;
+    let mut original = connect_websocket(bind_addr).await?;
+    send_initialize_request(&mut original, /*id*/ 1, "thread_creator").await?;
+    read_response_for_id(&mut original, /*id*/ 1).await?;
+    send_request(
+        &mut original,
+        "thread/start",
+        /*id*/ 2,
+        Some(serde_json::to_value(ThreadStartParams::default())?),
+    )
+    .await?;
+    let ThreadStartResponse { thread, .. } =
+        to_response(read_response_for_id(&mut original, /*id*/ 2).await?)?;
+
+    let mut subscriber = connect_websocket(bind_addr).await?;
+    send_request(
+        &mut subscriber,
+        "initialize",
+        /*id*/ 1,
+        Some(json!({
+            "clientInfo": { "name": "thread_subscriber", "version": "0.1.0" },
+            "capabilities": { "experimentalApi": true },
+        })),
+    )
+    .await?;
+    read_response_for_id(&mut subscriber, /*id*/ 1).await?;
+    send_request(
+        &mut subscriber,
+        "thread/subscribe",
+        /*id*/ 2,
+        Some(json!({ "threadId": thread.id })),
+    )
+    .await?;
+    let attached: ThreadSubscribeResponse =
+        to_response(read_response_for_id(&mut subscriber, /*id*/ 2).await?)?;
+    assert_eq!(
+        attached,
+        ThreadSubscribeResponse {
+            thread_id: thread.id.clone()
+        }
+    );
+
+    original.close(None).await?;
+    drop(original);
+    send_request(
+        &mut subscriber,
+        "turn/start",
+        /*id*/ 3,
+        Some(serde_json::to_value(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "Hello".to_string(),
+                text_elements: vec![],
+            }],
+            ..Default::default()
+        })?),
+    )
+    .await?;
+    let started: TurnStartResponse =
+        to_response(read_response_for_id(&mut subscriber, /*id*/ 3).await?)?;
+    let completed = read_notification_for_method(&mut subscriber, "turn/completed").await?;
+    let completed: TurnCompletedNotification = serde_json::from_value(completed.params.unwrap())?;
+    assert_eq!(
+        (
+            completed.thread_id,
+            completed.turn.id,
+            completed.turn.status
+        ),
+        (thread.id.clone(), started.turn.id, TurnStatus::Completed),
+    );
+
+    send_request(
+        &mut subscriber,
+        "thread/archive",
+        /*id*/ 4,
+        Some(json!({ "threadId": thread.id })),
+    )
+    .await?;
+    read_response_for_id(&mut subscriber, /*id*/ 4).await?;
+    send_request(
+        &mut subscriber,
+        "thread/subscribe",
+        /*id*/ 5,
+        Some(json!({ "threadId": thread.id })),
+    )
+    .await?;
+    let rejected = read_error_for_id(&mut subscriber, /*id*/ 5).await?;
+    assert_eq!(rejected.error.code, -32600);
+    assert_eq!(
+        rejected.error.message,
+        format!("thread not found: {}", thread.id)
+    );
+    process.kill().await?;
+    Ok(())
+}
