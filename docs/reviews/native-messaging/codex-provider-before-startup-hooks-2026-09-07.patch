diff --git a/codex-rs/hooks/src/engine/session_start_identity_tests.rs b/codex-rs/hooks/src/engine/session_start_identity_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9f726b8dca20caea7143cff1a03ab3b1855992a3
--- /dev/null
+++ b/codex-rs/hooks/src/engine/session_start_identity_tests.rs
@@ -0,0 +1,121 @@
+use std::sync::Arc;
+
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::HookEventName;
+use codex_protocol::protocol::HookRunStatus;
+use codex_protocol::protocol::HookSource;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use futures::future::BoxFuture;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+use super::ClaudeHooksEngine;
+use super::CommandHookRuntime;
+use super::CommandShell;
+use super::ConfiguredHandler;
+use super::ConfiguredHandlerKind;
+use crate::events::session_start::SessionStartRequest;
+use crate::events::session_start::SessionStartSource;
+use crate::events::session_start::StartHookTarget;
+use crate::mcp::HookMcpCall;
+use crate::mcp::HookMcpExecutor;
+
+struct EchoHookInput;
+
+impl HookMcpExecutor for EchoHookInput {
+    fn execute(&self, call: HookMcpCall) -> BoxFuture<'_, anyhow::Result<String>> {
+        Box::pin(async move { Ok(format!("received {}", json!(call.input))) })
+    }
+}
+
+#[tokio::test]
+async fn start_hook_payload_preserves_session_and_exact_thread_identity() {
+    let session_id = ThreadId::new();
+    let thread_id = ThreadId::new();
+    let cwd = AbsolutePathBuf::current_dir().expect("current directory");
+    let (sender, _receiver) = async_channel::unbounded();
+    let runtime = CommandHookRuntime::new(
+        CommandShell {
+            program: String::new(),
+            args: Vec::new(),
+        },
+        Arc::new(Vec::new()),
+        thread_id,
+        sender,
+    );
+    let mut engine = ClaudeHooksEngine::new(
+        /*enabled*/ true,
+        /*bypass_hook_trust*/ false,
+        /*config_layer_stack*/ None,
+        Vec::new(),
+        Vec::new(),
+        runtime,
+        Arc::new(EchoHookInput),
+    );
+
+    for (event_name, target) in [
+        (
+            HookEventName::SessionStart,
+            StartHookTarget::SessionStart {
+                source: SessionStartSource::Startup,
+            },
+        ),
+        (
+            HookEventName::SubagentStart,
+            StartHookTarget::SubagentStart {
+                turn_id: "child-turn".to_string(),
+                agent_id: thread_id.to_string(),
+                agent_type: "worker".to_string(),
+            },
+        ),
+    ] {
+        engine.handlers = vec![ConfiguredHandler {
+            builtin: false,
+            event_name,
+            matcher: None,
+            timeout_sec: 5,
+            status_message: None,
+            additional_context_limit: Default::default(),
+            source_path: cwd.join("hooks.json").into(),
+            source: HookSource::User,
+            display_order: 0,
+            kind: ConfiguredHandlerKind::McpTool {
+                server: "fixture".to_string(),
+                tool: "echo_input".to_string(),
+                input: serde_json::from_value(json!({
+                    "session_id": "${session_id}",
+                    "thread_id": "${thread_id}",
+                }))
+                .expect("hook argument template"),
+            },
+        }];
+        let outcome = engine
+            .run_session_start(
+                SessionStartRequest {
+                    session_id,
+                    thread_id,
+                    cwd: cwd.clone(),
+                    transcript_path: None,
+                    model: "fixture-model".to_string(),
+                    permission_mode: "default".to_string(),
+                    target,
+                },
+                /*turn_id*/ None,
+            )
+            .await;
+        assert_eq!(outcome.hook_events.len(), 1);
+        assert_eq!(
+            outcome.hook_events[0].run.status,
+            HookRunStatus::Completed,
+            "{:?}",
+            outcome.hook_events
+        );
+        assert_eq!(
+            outcome.additional_contexts,
+            vec![format!(
+                "received {}",
+                json!({ "session_id": session_id, "thread_id": thread_id })
+            )]
+        );
+    }
+}
diff --git a/codex-rs/hooks/src/engine/thread_environment_tests.rs b/codex-rs/hooks/src/engine/thread_environment_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..209b184fbdf3216b301abdcf6320da02157a784f
--- /dev/null
+++ b/codex-rs/hooks/src/engine/thread_environment_tests.rs
@@ -0,0 +1,130 @@
+use std::collections::HashMap;
+
+use codex_config::ConfigLayerEntry;
+use codex_config::ConfigLayerSource;
+use codex_config::ConfigLayerStack;
+use codex_config::ConfigRequirements;
+use codex_config::ConfigRequirementsToml;
+use codex_config::TomlValue;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::HookRunStatus;
+use codex_protocol::shell_environment::CODEX_EXEC_SERVER_NOISE_AUTH_TOKEN_ENV_VAR;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::tempdir;
+
+use crate::Hooks;
+use crate::HooksConfig;
+use crate::SessionStartRequest;
+use crate::SessionStartSource;
+use crate::StartHookTarget;
+use crate::engine::tests::mcp_executor;
+
+#[tokio::test]
+async fn thread_hook_environment_is_isolated_and_refresh_removes_old_overrides() {
+    let temp = tempdir().expect("hook directory");
+    let cwd = AbsolutePathBuf::try_from(temp.path().to_path_buf()).expect("absolute directory");
+    let first_id = ThreadId::new();
+    let second_id = ThreadId::new();
+    let variable = format!("HOOK_TEST_{}", first_id.to_string().replace('-', "_"));
+    let script = cwd.join("environment.py");
+    std::fs::write(
+        &script,
+        format!(
+            "import json, os, sys\njson.load(sys.stdin)\nprint('observed ' + json.dumps([os.environ.get({variable:?}), os.environ.get({CODEX_EXEC_SERVER_NOISE_AUTH_TOKEN_ENV_VAR:?})]))\n"
+        ),
+    )
+    .expect("hook script");
+    let command = format!("python3 \"{}\"", script.display());
+    let layer = TomlValue::try_from(json!({
+        "hooks": {"SessionStart": [{"hooks": [{"type": "command", "command": command}]}]}
+    }))
+    .expect("hook layer");
+    let config = HooksConfig {
+        feature_enabled: true,
+        config_layer_stack: Some(
+            ConfigLayerStack::new(
+                vec![ConfigLayerEntry::new(
+                    ConfigLayerSource::System {
+                        file: cwd.join("config.toml"),
+                    },
+                    layer,
+                )],
+                ConfigRequirements::default(),
+                ConfigRequirementsToml::default(),
+            )
+            .expect("hook configuration"),
+        ),
+        ..Default::default()
+    };
+    let first_config = HooksConfig {
+        environment_overrides: HashMap::from([
+            (variable.clone(), first_id.to_string()),
+            (
+                CODEX_EXEC_SERVER_NOISE_AUTH_TOKEN_ENV_VAR.to_owned(),
+                "test-only".to_owned(),
+            ),
+        ]),
+        ..config.clone()
+    };
+    let second_config = HooksConfig {
+        environment_overrides: HashMap::from([(variable.clone(), second_id.to_string())]),
+        ..config.clone()
+    };
+    let (first, _first_results) =
+        Hooks::new(first_config, first_id, mcp_executor()).expect("first");
+    let (second, _second_results) =
+        Hooks::new(second_config, second_id, mcp_executor()).expect("second");
+    let rotated_value = ThreadId::new().to_string();
+    let rotated = first.reconfigured(HooksConfig {
+        environment_overrides: HashMap::from([(variable, rotated_value.clone())]),
+        ..config.clone()
+    });
+    let refreshed = rotated.reconfigured(config);
+
+    // Execute both original snapshots after reconfiguration too: refreshing one
+    // thread must neither mutate the other nor rewrite already captured work.
+    for (hooks, thread_id, expected) in [
+        (&first, first_id, Some(first_id.to_string())),
+        (&second, second_id, Some(second_id.to_string())),
+        (&rotated, first_id, Some(rotated_value)),
+        (&refreshed, first_id, None),
+        (&first, first_id, Some(first_id.to_string())),
+        (&second, second_id, Some(second_id.to_string())),
+    ] {
+        let outcome = hooks
+            .run_session_start(
+                SessionStartRequest {
+                    session_id: thread_id,
+                    thread_id,
+                    cwd: cwd.clone(),
+                    transcript_path: None,
+                    model: "fixture-model".to_owned(),
+                    permission_mode: "default".to_owned(),
+                    target: StartHookTarget::SessionStart {
+                        source: SessionStartSource::Startup,
+                    },
+                },
+                /*turn_id*/ None,
+            )
+            .await;
+        assert_eq!(outcome.hook_events.len(), 1);
+        assert_eq!(
+            outcome.hook_events[0].run.status,
+            HookRunStatus::Completed,
+            "{:?}",
+            outcome.hook_events
+        );
+        assert_eq!(outcome.additional_contexts.len(), 1);
+        let observed: serde_json::Value = serde_json::from_str(
+            outcome.additional_contexts[0]
+                .strip_prefix("observed ")
+                .expect("hook output"),
+        )
+        .expect("environment observation");
+        assert_eq!(observed, json!([expected, null]));
+    }
+    refreshed.shutdown().await;
+    second.shutdown().await;
+}
