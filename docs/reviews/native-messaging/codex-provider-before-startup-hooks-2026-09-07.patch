+#[tokio::test]
+async fn thread_subscribe_attaches_without_starting_a_turn() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri()).write(codex_home.path())?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    let thread = client
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread;
+    let unsubscribed: ThreadUnsubscribeResponse = client
+        .request(|request_id| ClientRequest::ThreadUnsubscribe {
+            request_id,
+            params: ThreadUnsubscribeParams {
+                thread_id: thread.id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(
+        unsubscribed,
+        ThreadUnsubscribeResponse {
+            status: ThreadUnsubscribeStatus::Unsubscribed,
+        }
+    );
+
+    let subscribed: ThreadSubscribeResponse = client
+        .request(|request_id| ClientRequest::ThreadSubscribe {
+            request_id,
+            params: ThreadSubscribeParams {
+                thread_id: thread.id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(
+        subscribed,
+        ThreadSubscribeResponse {
+            thread_id: thread.id.clone()
+        }
+    );
+    let read: ThreadReadResponse = client
+        .request(|request_id| ClientRequest::ThreadRead {
+            request_id,
+            params: ThreadReadParams {
+                thread_id: thread.id.clone(),
+                include_turns: false,
+            },
+        })
+        .await?;
+    assert_eq!(
+        (
+            read.thread.id,
+            read.thread.status,
+            read.thread.can_accept_direct_input
+        ),
+        (thread.id.clone(), ThreadStatus::Idle, Some(true)),
+        "subscription must leave the same thread idle and available"
+    );
+    let removed: ThreadUnsubscribeResponse = client
+        .request(|request_id| ClientRequest::ThreadUnsubscribe {
+            request_id,
+            params: ThreadUnsubscribeParams {
+                thread_id: thread.id,
+            },
+        })
+        .await?;
+    assert_eq!(removed, unsubscribed, "subscription was not registered");
+    let status = timeout(DEFAULT_READ_TIMEOUT, client.shutdown_gracefully()).await??;
+    assert!(status.success(), "app-server did not shut down cleanly");
+    let requests = server.received_requests().await.expect("recorded requests");
+    assert_eq!(
+        requests
+            .iter()
+            .filter(|request| request.url.path().ends_with("/responses"))
+            .count(),
+        0,
+        "subscription must not initiate model inference"
+    );
+    Ok(())
+}
